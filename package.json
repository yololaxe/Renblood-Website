{
  "name": "renblood-website",
  "version": "1.0.0",
  "description": "Projet du serveur Renblood",
  "type": "module",
  "scripts": {
    "dev": "vite",

    "preview": "vite preview",

    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",

    "deploy:prod": "npm run build:prod && firebase deploy --only hosting:prod --project renblood-website",
